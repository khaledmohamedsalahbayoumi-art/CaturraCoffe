{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/caturra",
      "permanent": true
    },
    {
      "source": "/admin/",
      "destination": "/caturra",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|invoices/|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
