{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/caturra",
      "permanent": true
    },
    {
      "source": "/admin/",
      "destination": "/caturra",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|invoices/|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
